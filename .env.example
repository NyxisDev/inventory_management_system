# Copy to .env and change every value marked MUST BE CHANGED.
# .env is git-ignored. Never commit real secrets.
# Generate a secret: openssl rand -hex 32

# ---------- Database (PostgreSQL 16) ----------
POSTGRES_DB=inventory
# Superuser of the database container. Used only for set-up, backups and restore.
POSTGRES_USER=postgres
# MUST BE CHANGED: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# Passwords of the two application roles. backend/db/init_roles.sql creates the roles with them
# on the first start of the db container. Use hex values (openssl rand -hex 24) so they can go into the URLs below as is.
# MUST BE CHANGED
APP_OWNER_PASSWORD=change-me
# MUST BE CHANGED
APP_USER_PASSWORD=change-me
# Owner of the tables; Alembic migrations run as this role.
# MUST BE CHANGED: the password must be APP_OWNER_PASSWORD.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://app_owner:change-me@db:5432/inventory
# The API runs as app_user: no superuser, no CREATE, audit_log is insert-only.
# MUST BE CHANGED: the password must be APP_USER_PASSWORD.
DATABASE_URL=postgresql+asyncpg://app_user:change-me@db:5432/inventory

# ---------- Backend (FastAPI) ----------
# MUST BE CHANGED: at least 32 bytes. openssl rand -hex 32. The API refuses to start with a weak value.
JWT_SECRET=change-me
# Access token lifetime in minutes.
JWT_EXPIRE_MINUTES=15
# Refresh token lifetime in days.
REFRESH_EXPIRE_DAYS=7
# First admin, created by "make seed". MUST BE CHANGED: 10+ characters, a letter and a digit.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-123
# Where product photos are stored inside the backend container (a Docker volume).
MEDIA_DIR=/app/media
# Sites allowed to call the API with cookies. Comma-separated, never "*".
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
# Swagger at /docs. Keep false in production.
ENABLE_DOCS=false
# The API is behind nginx: take the client IP from X-Forwarded-For.
TRUST_PROXY=true
# Refresh cookie only over HTTPS. Set false only for local HTTP.
COOKIE_SECURE=false

# ---------- Catalog site (shop-site) ----------
# Shown in the header, footer and page titles.
SITE_NAME=BuildStock
# Public address of the catalog, used for canonical links and sitemap.xml.
SITE_URL=http://localhost:8080
# Shop contacts shown on every page. Replace the demo values.
SHOP_PHONE=+000 000 000 000
SHOP_EMAIL=info@example.com
SHOP_ADDRESS=Sample Street 12, Industrial Zone
# Opening hours, lines separated by ";".
SHOP_HOURS=Mon–Fri 7:00–18:00; Sat 8:00–14:00; Sun closed
# Currency code for prices (ISO 4217).
CURRENCY=EUR
# true = the catalog shows built-in demo products instead of the API.
SHOP_MOCK_API=false

# ---------- nginx and domains ----------
# Local ports: catalog and admin app.
SHOP_PORT=8080
ADMIN_PORT=8081
# 127.0.0.1 = only this computer (and Caddy). Use 0.0.0.0 to open the ports to the network.
BIND_ADDRESS=127.0.0.1
# Production domains (HTTPS through Caddy, docker-compose.https.yml).
SHOP_DOMAIN=shop.example.com
ADMIN_DOMAIN=admin.example.com
# E-mail for Let's Encrypt notices.
ACME_EMAIL=admin@example.com
