# Single entry point. Rendered by the nginx image at start-up:
# ${SHOP_DOMAIN} and ${ADMIN_DOMAIN} come from the environment (docker-compose.yml).
#
# Ports inside the container (the image runs as a non-root user):
#   8080  catalog site (local:  http://localhost:8080)
#   8081  admin app    (local:  http://localhost:8081)
#   8088  both, chosen by domain name; HTTPS (Caddy) forwards here in production

server_tokens off;
client_max_body_size 25m;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_min_length 1024;
gzip_comp_level 5;
gzip_types text/plain text/css text/xml application/json application/javascript application/xml image/svg+xml;

# Docker's DNS. Upstreams are resolved per request, so nginx starts even if a
# service is not running yet (for example only the catalog in demo mode).
resolver 127.0.0.11 valid=10s ipv6=off;

# Real client IP when a proxy (Caddy) on the Docker network is in front.
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Unknown host names on the domain port get no answer.
server {
    listen 8088 default_server;
    server_name _;
    return 444;
}

# ---------- catalog site ----------
server {
    listen 8080 default_server;
    listen 8088;
    server_name ${SHOP_DOMAIN};

    set $shop_upstream    http://shop-site:3000;
    set $backend_upstream http://backend:8000;

    include /etc/nginx/snippets/security-headers.conf;

    location /api/ {
        include /etc/nginx/snippets/proxy-backend.conf;
    }

    location /media/ {
        include /etc/nginx/snippets/media.conf;
    }

    location ~ /\. {
        deny all;
    }

    # Hashed build files from the SSR server.
    location /assets/ {
        proxy_pass $shop_upstream;
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Pages, robots.txt and sitemap.xml are rendered by the SSR server
    # (it also sends the Content-Security-Policy with a per-request nonce).
    location / {
        proxy_pass $shop_upstream;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}

# ---------- admin app ----------
server {
    listen 8081 default_server;
    listen 8088;
    server_name ${ADMIN_DOMAIN};

    set $admin_upstream   http://admin-app:8080;
    set $backend_upstream http://backend:8000;

    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/admin-headers.conf;

    location = /robots.txt {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/admin-headers.conf;
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location /api/ {
        include /etc/nginx/snippets/proxy-backend.conf;
        include /etc/nginx/snippets/admin-headers.conf;
    }

    location /media/ {
        include /etc/nginx/snippets/media.conf;
    }

    location ~ /\. {
        deny all;
    }

    location / {
        proxy_pass $admin_upstream;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}
