# Local overrides for running the backend on your computer (not in Docker).
# Copy to backend/.env. Everything else (JWT_SECRET, ADMIN_*, ...) is read from the root .env;
# values here win over it.
#
# The database runs in Docker and is published on 127.0.0.1:5432:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db

# Same passwords as APP_USER_PASSWORD / APP_OWNER_PASSWORD in the root .env, host 127.0.0.1 instead of "db" ("localhost" can add a 2-second IPv6 delay on Windows).
# MUST BE CHANGED
DATABASE_URL=postgresql+asyncpg://app_user:change-me@127.0.0.1:5432/inventory
# MUST BE CHANGED
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://app_owner:change-me@127.0.0.1:5432/inventory

# Photos in backend/media instead of the container path /app/media
MEDIA_DIR=./media

# Swagger at http://localhost:8000/docs for local work
ENABLE_DOCS=true

# No nginx in front of the API locally: use the real client address
TRUST_PROXY=false
